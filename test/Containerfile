FROM rockylinux/rockylinux:9-ubi-init

# Install Puppet 8 repo + agent + HAProxy + tools
RUN rpm -Uvh https://yum.puppet.com/puppet8-release-el-9.noarch.rpm && \
    dnf install -y puppet-agent haproxy procps-ng && \
    dnf clean all

ENV PATH="/opt/puppetlabs/bin:/opt/puppetlabs/puppet/bin:${PATH}"

# Install r10k for Puppetfile module installation
RUN /opt/puppetlabs/puppet/bin/gem install r10k --no-document

# Copy the entire control repo as the production environment
COPY . /etc/puppetlabs/code/environments/production

# Install Forge modules via r10k
RUN cd /etc/puppetlabs/code/environments/production && \
    r10k puppetfile install --puppetfile Puppetfile --moduledir modules

# systemd init (from ubi-init base)
CMD ["/sbin/init"]
